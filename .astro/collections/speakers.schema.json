{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "affiliation": {
      "type": "string"
    },
    "image": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "twitter": {
      "type": "string"
    },
    "homepage": {
      "type": "string",
      "format": "uri"
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "name"
  ],
  "additionalProperties": false
}