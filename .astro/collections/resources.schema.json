{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "resourceType": {
      "type": "string",
      "enum": [
        "video",
        "document",
        "external",
        "text",
        "image",
        "audio"
      ]
    },
    "sourceUrl": {
      "type": "string"
    },
    "videoEmbedCode": {
      "type": "string"
    },
    "document": {
      "type": "string"
    },
    "authorship": {
      "type": "string"
    },
    "publicationDate": {
      "type": "string"
    },
    "tags": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "date": {
      "type": "string",
      "format": "date-time"
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "resourceType",
    "tags"
  ],
  "additionalProperties": false
}