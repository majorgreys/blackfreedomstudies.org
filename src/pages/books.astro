---
import { getCollection, render } from 'astro:content';
import { Layout, isClassic } from '../lib/theme';

const pagesCollection = await getCollection('pages');
const booksPage = pagesCollection.find(p => p.id === 'books');
const { Content } = booksPage ? await render(booksPage) : { Content: null };

// Parse the markdown list into structured data
// Each line is: - *Title* by Author  OR  - *Title* edited by Editor
const booksRaw = await import('../content/pages/books.md?raw');
const lines = (booksRaw.default || '').split('\n').filter((l: string) => l.startsWith('- '));

const books = lines.map((line: string, i: number) => {
  // Remove leading "- "
  let text = line.substring(2).trim();
  // Extract title (between * *)
  const titleMatch = text.match(/\*([^*]+)\*/);
  const title = titleMatch ? titleMatch[1] : text;
  // Extract author (after "by " or "edited by ")
  const authorMatch = text.match(/(?:edited )?by (.+)$/);
  const author = authorMatch ? authorMatch[1] : '';
  return { title, author };
});
---
<Layout title="Books" description="A decade of scholarship featured in Conversations in Black Freedom Studies — nearly 200 books spanning civil rights, Black Power, education, policing, culture, and internationalism.">
  {isClassic ? (
    <div>
      <div class="c-page-header">
        <h1>Books</h1>
      </div>
      <div class="c-about-content">
        <div>
          {Content && <Content />}
        </div>
      </div>
    </div>
  ) : (
    <div>
      <div class="r-page-header">
        <h1>Books</h1>
        <p>Nearly 200 books spanning civil rights, Black Power, education, policing, abolition, culture, and internationalism</p>
      </div>
      <div class="r-archive-bar">
        <label class="r-archive-bar__search">
          <span class="r-visually-hidden">Search books</span>
          <input type="search" id="book-search" placeholder={`Search ${books.length} books by title or author…`} autocomplete="off" />
        </label>
      </div>
      <p class="r-archive-empty" id="book-search-empty" hidden>No books match.</p>
      <p class="r-visually-hidden" role="status" id="book-search-status"></p>
      <ul class="r-book-list">
        {books.map(book => (
          <li class="r-book" data-search={`${book.title} ${book.author}`.toLowerCase()}>
            <cite class="r-book__title">{book.title}</cite>
            {book.author && <span class="r-book__author">{book.author}</span>}
          </li>
        ))}
      </ul>
      <script>
        const input = document.getElementById('book-search') as HTMLInputElement | null;
        const empty = document.getElementById('book-search-empty');
        input?.addEventListener('input', () => {
          const q = input.value.trim().toLowerCase();
          let shown = 0;
          document.querySelectorAll<HTMLElement>('.r-book').forEach(li => {
            const match = !q || (li.dataset.search ?? '').includes(q);
            li.hidden = !match;
            if (match) shown++;
          });
          if (empty) empty.hidden = shown > 0;
          const status = document.getElementById('book-search-status');
          if (status) status.textContent = q ? `${shown} ${shown === 1 ? 'book' : 'books'} match` : '';
        });
      </script>
    </div>
  )}
</Layout>
