---
// Editor-facing report of images that are too small for where they're shown.
// Decap can't show image dimensions, so this is built with the site and linked
// from the admin. Not themed and kept out of the sitemap.
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

type Kind = 'Book cover' | 'Speaker photo' | 'News banner' | 'Interview image' | 'Page image';
interface Item {
  kind: Kind;
  collection: string;
  id: string;
  title: string;
  image: ImageMetadata | string;
}

// Minimum pixels for a sharp image on high-res screens: twice the largest size
// the image is displayed at. Speaker photos are cropped square, so the shorter
// side counts; the rest are measured by width.
const MIN: Record<Kind, number> = {
  'Book cover': 560,
  'Speaker photo': 640,
  'News banner': 1000,
  'Interview image': 800,
  'Page image': 800,
};

const items: Item[] = [];
for (const e of await getCollection('events')) {
  for (const book of e.data.books) items.push({ kind: 'Book cover', collection: 'events', id: e.id, title: e.data.title, image: book });
}
for (const s of await getCollection('speakers')) {
  if (s.data.image) items.push({ kind: 'Speaker photo', collection: 'speakers', id: s.id, title: s.data.name, image: s.data.image });
}
for (const n of await getCollection('news')) {
  const img = n.data.image;
  // Small or portrait news images are shown beside the text at natural size, not stretched
  const isBanner = typeof img === 'string' || (!!img && img.width >= 700 && img.width / img.height >= 1.2);
  if (img && isBanner) items.push({ kind: 'News banner', collection: 'news', id: n.id, title: n.data.title, image: img });
}
for (const i of await getCollection('interviews')) {
  if (i.data.image) items.push({ kind: 'Interview image', collection: 'interviews', id: i.id, title: i.data.title, image: i.data.image });
}
for (const p of await getCollection('pages')) {
  if (p.data.image) items.push({ kind: 'Page image', collection: 'pages', id: p.id, title: p.data.title, image: p.data.image });
}

const rows = items.map(item => {
  const external = typeof item.image === 'string';
  const meta = external ? null : (item.image as ImageMetadata);
  const size = meta ? (item.kind === 'Speaker photo' ? Math.min(meta.width, meta.height) : meta.width) : 0;
  const min = MIN[item.kind];
  const status = external ? 'external' : size < min / 2 ? 'blurry' : size < min ? 'soft' : 'ok';
  return { ...item, meta, size, min, status };
});
const flagged = rows
  .filter(r => r.status !== 'ok')
  .sort((a, b) => (a.status === 'external' ? -1 : b.status === 'external' ? 1 : a.size / a.min - b.size / b.min));
const counts = { external: 0, blurry: 0, soft: 0, ok: 0 };
rows.forEach(r => counts[r.status as keyof typeof counts]++);
const label = { external: 'Linked from another site', blurry: 'Blurry', soft: 'Soft on high-res screens' };
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex" />
  <title>Image audit — CBFS Content Manager</title>
  <style is:inline>
    body { font-family: system-ui, sans-serif; color: #1c1917; background: #fafaf9; margin: 0; padding: 24px 16px; }
    main { max-width: 1000px; margin: 0 auto; }
    h1 { margin: 0 0 4px; }
    .intro { color: #57534e; margin: 0 0 20px; max-width: 70ch; }
    .summary { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 20px; }
    .pill { padding: 4px 12px; border-radius: 999px; font-size: 0.85rem; font-weight: 600; }
    .external { background: #fee2e2; color: #991b1b; }
    .blurry { background: #ffedd5; color: #9a3412; }
    .soft { background: #fef9c3; color: #854d0e; }
    .ok { background: #dcfce7; color: #166534; }
    table { width: 100%; border-collapse: collapse; background: #fff; }
    th, td { text-align: left; padding: 8px 10px; border-bottom: 1px solid #e7e5e4; vertical-align: middle; font-size: 0.9rem; }
    th { font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; color: #78716c; }
    td img { width: 56px; height: 56px; object-fit: cover; border-radius: 4px; display: block; }
    a { color: #097367; }
    .file { font-size: 0.75rem; color: #78716c; margin-top: 2px; word-break: break-all; }
    @media (max-width: 640px) { .hide-sm { display: none; } }
  </style>
</head>
<body>
  <main>
    <p><a href="/admin/">← Back to the content manager</a></p>
    <h1>Image audit</h1>
    <p class="intro">
      Images that are too small for where the site shows them. "Soft" images look fine on most
      screens but not sharp on high-resolution ones; "blurry" images are under half the size needed.
      Replace an image by uploading a larger version in the linked entry. Updated each time the site is built.
    </p>
    <div class="summary">
      <span class="pill external">{counts.external} linked from another site</span>
      <span class="pill blurry">{counts.blurry} blurry</span>
      <span class="pill soft">{counts.soft} soft</span>
      <span class="pill ok">{counts.ok} OK</span>
    </div>
    <table>
      <thead>
        <tr><th></th><th>Entry</th><th class="hide-sm">Type</th><th>Size</th><th class="hide-sm">Needs</th><th>Status</th></tr>
      </thead>
      <tbody>
        {flagged.map(r => (
          <tr>
            <td>
              {r.meta
                ? <Image src={r.meta} alt="" width={56} height={56} />
                : <img src={r.image as string} alt="" referrerpolicy="no-referrer" loading="lazy" />}
            </td>
            <td>
              <a href={`/admin/#/collections/${r.collection}/entries/${r.id}`}>{r.title}</a>
              {r.kind === 'Book cover' && r.meta && <div class="file">{r.meta.src.split('/').pop()?.split('?')[0].replace(/\.[\w-]+(\.\w+)$/, '$1')}</div>}
            </td>
            <td class="hide-sm">{r.kind}</td>
            <td>{r.meta ? `${r.meta.width}×${r.meta.height}` : '—'}</td>
            <td class="hide-sm">{r.min}px {r.kind === 'Speaker photo' ? 'shorter side' : 'wide'}</td>
            <td><span class={`pill ${r.status}`}>{label[r.status as keyof typeof label]}</span></td>
          </tr>
        ))}
      </tbody>
    </table>
  </main>
</body>
</html>
