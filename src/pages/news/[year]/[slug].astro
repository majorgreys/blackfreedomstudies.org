---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import { Layout, isClassic } from '../../../lib/theme';
import { isNewsBanner } from '../../../lib/imageQuality';

export async function getStaticPaths() {
  const news = await getCollection('news');
  return news.map(entry => ({
    params: {
      year: String(entry.data.date.getFullYear()),
      slug: entry.id,
    },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const dateStr = entry.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
// Decap can store remote image URLs, which <Image> can't size without both dimensions
const image = entry.data.image;
const isRemote = typeof image === 'string' && /^https?:\/\//.test(image);
// Large landscape images are cropped to a fixed-shape banner; small or portrait
// images would be stretched and blurry, so they sit beside the text at natural size
const isBanner = isRemote || (!!image && isNewsBanner(image as ImageMetadata));
const focusY = { top: '0%', upper: '25%', center: '50%', lower: '75%', bottom: '100%' };
const focus = `center ${focusY[entry.data.imageFocus ?? 'center']}`;
const caption = entry.data.imageCaption;
---
<Layout title={entry.data.title} description={`${entry.data.title} — Conversations in Black Freedom Studies news, ${dateStr}.`} ogType="article">
  {isClassic ? (
    <article class="c-news-detail">
      {image && isBanner && (
        <figure class="c-news-banner">
          {isRemote ? (
            <img src={image as string} alt={entry.data.title} style={`object-position: ${focus}`} decoding="async" referrerpolicy="no-referrer" />
          ) : (
            <Image src={image as ImageMetadata} alt={entry.data.title} width={800} densities={[1, 2]} loading="eager" style={`object-position: ${focus}`} />
          )}
          {caption && <figcaption>{caption}</figcaption>}
        </figure>
      )}
      <h1>{entry.data.title}</h1>
      <p class="c-news-date">{dateStr}</p>
      {image && !isBanner && (
        <figure class="c-news-inset">
          <Image src={image as ImageMetadata} alt={entry.data.title} width={Math.min(240, (image as ImageMetadata).width)} densities={[1, 2]} />
          {caption && <figcaption>{caption}</figcaption>}
        </figure>
      )}
      <Content />
      {entry.data.tags.length > 0 && (
        <div class="c-tags">
          {entry.data.tags.map((tag: string) => <span class="c-tag">{tag}</span>)}
        </div>
      )}
    </article>
  ) : (
    <article>
      {image && isBanner && (
        <figure class="r-news-banner">
          {isRemote ? (
            <img src={image as string} alt={entry.data.title} style={`object-position: ${focus}`} decoding="async" referrerpolicy="no-referrer" />
          ) : (
            <Image src={image as ImageMetadata} alt={entry.data.title} width={900} densities={[1, 2]} loading="eager" style={`object-position: ${focus}`} />
          )}
          {caption && <figcaption>{caption}</figcaption>}
        </figure>
      )}
      <div class="r-page-header">
        <span class="r-news-date">{dateStr}</span>
        <h1>{entry.data.title}</h1>
      </div>
      <div class="r-prose">
        {image && !isBanner && (
          <figure class="r-news-inset">
            <Image src={image as ImageMetadata} alt={entry.data.title} width={Math.min(300, (image as ImageMetadata).width)} densities={[1, 2]} />
            {caption && <figcaption>{caption}</figcaption>}
          </figure>
        )}
        <Content />
      </div>
      {entry.data.tags.length > 0 && (
        <div class="r-tags">
          {entry.data.tags.map((tag: string) => <span class="r-tag">{tag}</span>)}
        </div>
      )}
    </article>
  )}
</Layout>
