---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import { Layout, isClassic } from '../../lib/theme';

const news = (await getCollection('news'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

// Render all news content for excerpts
const newsWithContent = await Promise.all(
  news.map(async (entry) => {
    const { Content } = await render(entry);
    return { entry, Content };
  })
);
---
<Layout title="News" description="Latest news, announcements, and updates from Conversations in Black Freedom Studies.">
  {isClassic ? (
    <div>
      <div class="c-page-header">
        <h1>News</h1>
      </div>
      {newsWithContent.map(({ entry, Content }) => (
        <article class="c-news-item">
          <h2><a href={`/news/${entry.data.date.getFullYear()}/${entry.id}`}>{entry.data.title}</a></h2>
          <p class="c-news-date">{entry.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</p>
          {entry.data.image && (
            <div class="c-news-images">
              <div class="c-news-images__crop">
                <Image src={entry.data.image} alt={entry.data.title} width={800} />
              </div>
            </div>
          )}
          <div class="c-news-excerpt">
            <Content />
          </div>
          <p><a href={`/news/${entry.data.date.getFullYear()}/${entry.id}`}>Continue reading</a></p>
        </article>
      ))}
    </div>
  ) : (
    <div>
      <div class="r-page-header">
        <h1>News</h1>
        <p>Announcements and updates from the series</p>
      </div>
      <div class="r-resource-list">
        {news.map((entry, i) => (
          <a href={`/news/${entry.data.date.getFullYear()}/${entry.id}`} class={`r-resource-row ${i % 2 === 0 ? '' : 'r-resource-row--alt'}`}>
            <div class="r-resource-row__date">
              {entry.data.date.toLocaleDateString('en-US', { month: 'short', year: 'numeric' })}
            </div>
            <div class="r-resource-row__title">{entry.data.title}</div>
          </a>
        ))}
      </div>
    </div>
  )}
</Layout>
