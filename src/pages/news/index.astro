---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import { Layout, isClassic } from '../../lib/theme';
import { excerpt } from '../../lib/excerpt';

const news = (await getCollection('news'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

// Render all news content for excerpts
const newsWithContent = await Promise.all(
  news.map(async (entry) => {
    const { Content } = await render(entry);
    return { entry, Content };
  })
);
---
<Layout title="News" description="Latest news, announcements, and updates from Conversations in Black Freedom Studies.">
  {isClassic ? (
    <div>
      <div class="c-page-header">
        <h1>News</h1>
      </div>
      {newsWithContent.map(({ entry, Content }) => (
        <article class="c-news-item">
          <h2><a href={`/news/${entry.data.date.getUTCFullYear()}/${entry.id}`}>{entry.data.title}</a></h2>
          <p class="c-news-date">{entry.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })}</p>
          {entry.data.image && (
            <div class="c-news-images">
              <div class="c-news-images__crop">
                <Image src={entry.data.image} alt="" width={800} />
              </div>
            </div>
          )}
          <div class="c-news-excerpt">
            <Content />
          </div>
          <p><a href={`/news/${entry.data.date.getUTCFullYear()}/${entry.id}`}>Continue reading</a></p>
        </article>
      ))}
    </div>
  ) : (
    <div>
      <div class="r-page-header">
        <h1>News</h1>
        <p>Season announcements, schedules and updates from the series</p>
      </div>
      <ol class="r-card-list">
        {news.map(entry => (
          <li class="r-card">
            <a class="r-card__link" href={`/news/${entry.data.date.getUTCFullYear()}/${entry.id}`}>
              <div class="r-card__body">
                <time class="r-card__date" datetime={entry.data.date.toISOString().slice(0, 10)}>
                  {entry.data.date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' })}
                </time>
                <h2 class="r-card__title">{entry.data.title}</h2>
                <p class="r-card__excerpt">{excerpt(entry.body)}</p>
              </div>
              {entry.data.image && (
                <Image class="r-card__thumb" src={entry.data.image} alt="" width={200} height={140} densities={[1, 2]} />
              )}
            </a>
          </li>
        ))}
      </ol>
    </div>
  )}
</Layout>
