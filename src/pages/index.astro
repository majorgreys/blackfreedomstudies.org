---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import { Layout, isClassic } from '../lib/theme';
import EventRow from '../components/redesign/EventRow.astro';

const pagesCollection = await getCollection('pages');
const homepage = pagesCollection.find(p => p.id === 'homepage' || p.id === 'index');
const newsEntries = await getCollection('news');
const sortedNews = newsEntries.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const latestNews = sortedNews.slice(0, 2);
const homeNews = sortedNews.slice(0, 3);

// Find next upcoming event for the hero CTA
const allEvents = await getCollection('events');
// Event dates are UTC midnight; keep an event as "next" through its whole day
const DAY_MS = 24 * 60 * 60 * 1000;
const now = Date.now();
const nextEvent = allEvents
  .filter(e => e.data.date.getTime() + DAY_MS > now)
  .sort((a, b) => a.data.date.getTime() - b.data.date.getTime())[0];

// The season of the next conversation (or the most recent season), for "This season"
const allSpeakers = await getCollection('speakers');
const latestEvent = [...allEvents].sort((a, b) => b.data.date.getTime() - a.data.date.getTime())[0];
const featured = nextEvent ?? latestEvent;
const seasonKey = featured ? `${featured.data.seasonPart}-${featured.data.seasonYear}` : '';
const seasonTitle = featured ? `${featured.data.seasonPart.charAt(0).toUpperCase() + featured.data.seasonPart.slice(1)} ${featured.data.seasonYear}` : '';
const seasonEvents = allEvents
  .filter(e => `${e.data.seasonPart}-${e.data.seasonYear}` === seasonKey)
  .sort((a, b) => a.data.date.getTime() - b.data.date.getTime());
const speakersFor = (event: (typeof allEvents)[number]) =>
  event.data.speakers
    .map((slug: string) => allSpeakers.find(s => s.id === slug))
    .filter((s): s is (typeof allSpeakers)[number] => Boolean(s));

let HomepageContent: any = null;
if (homepage) {
  const rendered = await render(homepage);
  HomepageContent = rendered.Content;
}

const organizationJsonLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "Conversations in Black Freedom Studies",
  "url": "https://blackfreedomstudies.org",
  "description": "A monthly roundtable discussion at the Schomburg Center for Research in Black Culture with authors and experts in Black history.",
  "logo": "https://blackfreedomstudies.org/images/CBFS-Logo-2.png",
  "sameAs": [
    "https://twitter.com/SchomburgCBFS"
  ],
  "parentOrganization": [
    {
      "@type": "Organization",
      "name": "Schomburg Center for Research in Black Culture",
      "url": "https://www.nypl.org/locations/schomburg"
    },
    {
      "@type": "Organization",
      "name": "City University of New York (CUNY) Graduate Center",
      "url": "https://gc.cuny.edu"
    }
  ]
};
---
<Layout
  title="Conversations in Black Freedom Studies"
  description="A monthly roundtable discussion at the Schomburg Center for Research in Black Culture with authors and experts in Black history."
  jsonLd={organizationJsonLd}
>
  {isClassic ? (
    <div>
      {homepage?.data.image ? (
        <div class="c-hero">
          <Image src={homepage.data.image} alt="Speakers in conversation before an audience at the Schomburg Center" width={800} />
          <div class="c-hero__overlay">
            <ul>
              {latestNews.map(entry => (
                <li>
                  <a href={`/news/${entry.data.date.getUTCFullYear()}/${entry.id}`}>{entry.data.title}</a>
                </li>
              ))}
            </ul>
          </div>
        </div>
      ) : (
        <div>
          <h1>Conversations in Black Freedom Studies</h1>
          <ul style="list-style:none;padding:0;margin:0 0 20px;">
            {latestNews.map(entry => (
              <li style="margin-bottom:6px;">
                <a href={`/news/${entry.data.date.getUTCFullYear()}/${entry.id}`}>{entry.data.title}</a>
              </li>
            ))}
          </ul>
        </div>
      )}
      {HomepageContent && <div class="c-homepage-content"><HomepageContent /></div>}
    </div>
  ) : (
    <div>
      <div class="r-hero">
        {homepage?.data.image && (
          <img src={(homepage.data.image as any).src} alt="Speakers in conversation before an audience at the Schomburg Center" />
        )}
        <div class="r-hero__content">
          <h1 class="r-hero__title">Conversations in<br/>Black Freedom Studies</h1>
          <p class="r-hero__subtitle">A monthly roundtable discussion at the Schomburg Center with authors and experts in Black history.</p>
          <div class="r-hero__actions">
            {nextEvent && (
              <a href={`/events/${nextEvent.data.seasonPart}-${nextEvent.data.seasonYear}/${nextEvent.id}`} class="r-hero__cta">
                Next: {nextEvent.data.title} — {nextEvent.data.date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', timeZone: 'UTC' })}
              </a>
            )}
          </div>
        </div>
      </div>

      <div class="r-home-grid">
        {seasonEvents.length > 0 && (
          <section class="r-home-season" aria-labelledby="home-season">
            <div class="r-home-heading">
              <h2 id="home-season">{seasonTitle}</h2>
              <a href={`/events/${seasonKey}/`}>Season page</a>
            </div>
            <div class="r-season-group__events r-season-group__events--page">
              {seasonEvents.map(event => <EventRow event={event} speakers={speakersFor(event)} />)}
            </div>
            <p class="r-home-more"><a href="/events/">Browse every conversation since 2013 →</a></p>
          </section>
        )}
        <aside class="r-home-side" aria-labelledby="home-news">
          <div class="r-home-heading">
            <h2 id="home-news">Latest news</h2>
            <a href="/news/">All news</a>
          </div>
          <ul class="r-home-news">
            {homeNews.map(entry => (
              <li>
                <time datetime={entry.data.date.toISOString().slice(0, 10)}>{entry.data.date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' })}</time>
                <a href={`/news/${entry.data.date.getUTCFullYear()}/${entry.id}`}>{entry.data.title}</a>
              </li>
            ))}
          </ul>
          <div class="r-home-heading"><h2>Explore the archive</h2></div>
          <ul class="r-home-links">
            <li><a href="/resources/">Recordings</a></li>
            <li><a href="/speakers/">Speakers</a></li>
            <li><a href="/interviews/">Interviews</a></li>
            <li><a href="/books">Books</a></li>
          </ul>
        </aside>
      </div>

      {HomepageContent && (
        <section class="r-home-about" aria-labelledby="home-about">
          <h2 id="home-about">About the series</h2>
          <div class="r-prose"><HomepageContent /></div>
        </section>
      )}
    </div>
  )}
</Layout>
