---
import { getCollection } from 'astro:content';
import { Layout, isClassic } from '../../lib/theme';
import GuideIndex from '../../components/redesign/GuideIndex.astro';
import RecordingsTabs from '../../components/redesign/RecordingsTabs.astro';

const resources = await getCollection('resources');
const recordings = resources
  .filter(r => (r.data.resourceType === 'video' || r.data.resourceType === 'external') && r.data.sourceUrl)
  .sort((a, b) => (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0));
---
<Layout title="Recordings" description="A guide to the Conversations in Black Freedom Studies recordings: find a person, place or topic and start at the minute it comes up.">
  {isClassic ? (
    <div>
      <div class="c-page-header">
        <h1>Recordings</h1>
      </div>
      {recordings.map(r => (
        <div class="c-resource-item">
          <a href={r.data.sourceUrl} target="_blank" rel="noopener">{r.data.title}</a>
          {r.data.date && <span class="text-muted"> — {r.data.date.toLocaleDateString('en-US', { year: 'numeric', timeZone: 'UTC' })}</span>}
        </div>
      ))}
    </div>
  ) : (
    <div>
      <div class="r-page-header">
        <h1>Recordings</h1>
        <p>Find where a person, place or topic comes up across the series</p>
      </div>
      <RecordingsTabs current="guide" />
      <GuideIndex />
    </div>
  )}
</Layout>
