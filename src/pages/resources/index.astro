---
import { getCollection } from 'astro:content';
import { Layout, isClassic } from '../../lib/theme';

const resources = await getCollection('resources');

// All video and external resources are recordings — combine them
const recordings = resources
  .filter(r => r.data.resourceType === 'video' || r.data.resourceType === 'external')
  .filter(r => r.data.sourceUrl)
  .sort((a, b) => {
    const dateA = a.data.date ? a.data.date.getTime() : 0;
    const dateB = b.data.date ? b.data.date.getTime() : 0;
    return dateB - dateA;
  });

const documents = resources.filter(r => r.data.resourceType === 'document');

const prefix = isClassic ? 'c' : 'r';
---
<Layout title="Recordings" description="Video recordings of past Conversations in Black Freedom Studies events at the Schomburg Center.">
  {isClassic ? (
    <div>
      <div class="c-page-header">
        <h1>Recordings</h1>
      </div>
      {recordings.map(r => (
        <div class="c-resource-item">
          <a href={r.data.sourceUrl} target="_blank" rel="noopener">{r.data.title}</a>
          {r.data.date && <span class="text-muted"> — {r.data.date.toLocaleDateString('en-US', { year: 'numeric' })}</span>}
        </div>
      ))}
    </div>
  ) : (
    <div>
      <div class="r-page-header">
        <h1>Recordings</h1>
        <p>Video recordings of past conversations at the Schomburg Center</p>
      </div>
      <div class="r-resource-list" data-show-more="25">
        {recordings.map((r, i) => (
          <a href={r.data.sourceUrl} target="_blank" rel="noopener" class={`r-resource-row ${i % 2 === 0 ? '' : 'r-resource-row--alt'}`}>
            <div class="r-resource-row__icon">▶</div>
            <div class="r-resource-row__title">{r.data.title}</div>
            {r.data.date && (
              <div class="r-resource-row__date">
                {r.data.date.toLocaleDateString('en-US', { year: 'numeric' })}
              </div>
            )}
          </a>
        ))}
      </div>

      {documents.length > 0 && (
        <div style="margin-top:48px;">
          <h2 class="r-section-heading">Documents</h2>
          <div class="r-resource-list">
            {documents.map((r, i) => (
              <div class={`r-resource-row ${i % 2 === 0 ? '' : 'r-resource-row--alt'}`}>
                <div class="r-resource-row__title">
                  {r.data.document ? (
                    <a href={r.data.document} download>{r.data.title}</a>
                  ) : (
                    <span>{r.data.title}</span>
                  )}
                </div>
                {r.data.authorship && <div class="r-resource-row__author">{r.data.authorship}</div>}
              </div>
            ))}
          </div>
        </div>
      )}
    </div>
  )}
</Layout>

<script>
  document.querySelectorAll('[data-show-more]').forEach(function (list) {
    var limit = parseInt(list.getAttribute('data-show-more'), 10);
    var items = Array.from(list.children).filter(function (el) {
      return !el.classList.contains('r-show-more-btn');
    });
    if (items.length <= limit) return;

    // Hide items beyond the limit
    items.forEach(function (item, i) {
      if (i >= limit) item.style.display = 'none';
    });

    // Create the button
    var btn = document.createElement('button');
    btn.className = 'r-show-more-btn';
    btn.textContent = 'Show all ' + items.length + ' items';
    btn.type = 'button';
    list.parentNode.insertBefore(btn, list.nextSibling);

    btn.addEventListener('click', function () {
      items.forEach(function (item) {
        item.style.display = '';
      });
      btn.remove();
    });
  });
</script>
