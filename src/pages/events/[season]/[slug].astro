---
import { getCollection, render } from 'astro:content';
import { Layout, SpeakerCard, BookGrid, isClassic } from '../../../lib/theme';
import VideoEmbed from '../../../components/shared/VideoEmbed.astro';

export async function getStaticPaths() {
  const events = await getCollection('events');
  return events.map(event => ({
    params: {
      season: `${event.data.seasonPart}-${event.data.seasonYear}`,
      slug: event.id,
    },
    props: { event },
  }));
}

const { event } = Astro.props;
const { Content } = await render(event);
const month = event.data.date.toLocaleDateString('en-US', { month: 'short' });
const day = event.data.date.getDate();

const allSpeakers = await getCollection('speakers');
const speakers = event.data.speakers
  .map((slug: string) => allSpeakers.find(s => s.id === slug))
  .filter(Boolean);

// Render speaker bios
const speakerBios = new Map();
for (const speaker of speakers) {
  const { Content: BioContent } = await render(speaker as any);
  speakerBios.set(speaker.id, BioContent);
}

const allResources = await getCollection('resources');
const video = event.data.video
  ? allResources.find(r => r.id === event.data.video)
  : null;

const primaryResources = event.data.primaryResources
  .map((slug: string) => allResources.find(r => r.id === slug))
  .filter(Boolean);

const isFuture = event.data.date > new Date();

const speakerNames = speakers.map((s: any) => s.data.name).join(', ');
const eventDescription = `${event.data.title} — featuring ${speakerNames || 'guest speakers'}. A Conversations in Black Freedom Studies event at the Schomburg Center.`;
const eventDate = event.data.date.toISOString().split('T')[0];

const eventJsonLd = {
  "@context": "https://schema.org",
  "@type": "Event",
  "name": event.data.title,
  "description": eventDescription,
  "startDate": eventDate,
  "eventStatus": "https://schema.org/EventScheduled",
  "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
  "location": {
    "@type": "Place",
    "name": "Schomburg Center for Research in Black Culture",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "515 Malcolm X Blvd",
      "addressLocality": "New York",
      "addressRegion": "NY",
      "postalCode": "10037",
      "addressCountry": "US"
    }
  },
  "organizer": {
    "@type": "Organization",
    "name": "Conversations in Black Freedom Studies",
    "url": "https://blackfreedomstudies.org"
  },
  "performer": speakers.map((s: any) => ({
    "@type": "Person",
    "name": s.data.name,
    ...(s.data.affiliation ? { "affiliation": { "@type": "Organization", "name": s.data.affiliation } } : {})
  })),
};
---
<Layout title={event.data.title} description={eventDescription} ogType="article" jsonLd={eventJsonLd}>
  {isClassic ? (
    <div class="c-event-single">
      <div class="c-event-header">
        <div class="c-event-date">
          <span class="c-event-date__month">{month}</span>
          <span class="c-event-date__day">{day}</span>
        </div>
        <div class="c-event-name">
          <h2>{event.data.title}</h2>
        </div>
      </div>

      {isFuture && event.data.eventbrite && (
        <a href={event.data.eventbrite} target="_blank" rel="noopener" class="c-btn-register">Register on Eventbrite</a>
      )}

      <BookGrid books={event.data.books} />

      <section>
        <h3 class="c-section-header">Description</h3>
        <div>
          <Content />
        </div>
      </section>

      {speakers.length > 0 && (
        <section>
          <h3 class="c-section-header">Speakers</h3>
          <div>
            <ul class="c-event-speakers">
              {speakers.map((speaker: any) => {
                const BioContent = speakerBios.get(speaker.id);
                return (
                  <SpeakerCard
                    name={speaker.data.name}
                    slug={speaker.id}
                    affiliation={speaker.data.affiliation}
                    image={speaker.data.image}
                    email={speaker.data.email}
                    twitter={speaker.data.twitter}
                    homepage={speaker.data.homepage}
                  >
                    {BioContent && <div class="c-speaker-bio"><BioContent /></div>}
                  </SpeakerCard>
                );
              })}
            </ul>
          </div>
        </section>
      )}

      {video && (
        <section>
          <h3 class="c-section-header">Recording</h3>
          <div class="c-video-embed">
            <VideoEmbed url={video.data.sourceUrl} embedCode={video.data.videoEmbedCode} />
          </div>
        </section>
      )}

      {primaryResources.length > 0 && (
        <section>
          <h3 class="c-section-header">Primary Resources</h3>
          <div>
            <ul>
              {primaryResources.map((resource: any) => (
                <li>
                  {resource.data.sourceUrl ? (
                    <a href={resource.data.sourceUrl} target="_blank" rel="noopener">{resource.data.title}</a>
                  ) : (
                    <span>{resource.data.title}</span>
                  )}
                </li>
              ))}
            </ul>
          </div>
        </section>
      )}
    </div>
  ) : (
    <div>
      <div class="r-event-hero">
        <div class="container" style="display:flex;align-items:flex-start;gap:24px;">
          <div class="r-event-hero__date">
            <span class="r-event-hero__month">{month}</span>
            <span class="r-event-hero__day">{day}</span>
          </div>
          <div>
            <h1>{event.data.title}</h1>
          </div>
        </div>
      </div>

      {isFuture && event.data.eventbrite && (
        <a href={event.data.eventbrite} target="_blank" rel="noopener" class="r-btn-register">→ Register on Eventbrite</a>
      )}

      <BookGrid books={event.data.books} />

      <div class="r-prose">
        <Content />
      </div>

      {speakers.length > 0 && (
        <section>
          <h2>Speakers</h2>
          <ul class="r-speaker-list">
            {speakers.map((speaker: any) => (
              <SpeakerCard
                name={speaker.data.name}
                slug={speaker.id}
                affiliation={speaker.data.affiliation}
                image={speaker.data.image}
                email={speaker.data.email}
                twitter={speaker.data.twitter}
                homepage={speaker.data.homepage}
              />
            ))}
          </ul>
        </section>
      )}

      {video && (
        <section>
          <h2>Recording</h2>
          <VideoEmbed url={video.data.sourceUrl} embedCode={video.data.videoEmbedCode} />
        </section>
      )}

      {primaryResources.length > 0 && (
        <section>
          <h2>Primary Resources</h2>
          <ul class="r-appearances">
            {primaryResources.map((resource: any) => (
              <li>
                {resource.data.sourceUrl ? (
                  <a href={resource.data.sourceUrl} target="_blank" rel="noopener">{resource.data.title}</a>
                ) : (
                  <span>{resource.data.title}</span>
                )}
              </li>
            ))}
          </ul>
        </section>
      )}
    </div>
  )}
</Layout>
