---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { Layout, isClassic } from '../../lib/theme';

const events = await getCollection('events');
const allSpeakers = await getCollection('speakers');

const seasons = new Map<string, typeof events>();
for (const event of events) {
  const key = `${event.data.seasonPart}-${event.data.seasonYear}`;
  if (!seasons.has(key)) seasons.set(key, []);
  seasons.get(key)!.push(event);
}

const partOrder: Record<string, number> = { fall: 2, spring: 1, special: 0 };
const sortedSeasons = [...seasons.entries()].sort((a, b) => {
  const aYear = parseInt(a[0].split('-')[1]);
  const bYear = parseInt(b[0].split('-')[1]);
  if (aYear !== bYear) return bYear - aYear;
  const aPart = a[0].split('-')[0];
  const bPart = b[0].split('-')[0];
  return (partOrder[bPart] ?? 0) - (partOrder[aPart] ?? 0);
});

// Sort events within each season by date
for (const [, evts] of sortedSeasons) {
  evts.sort((a, b) => a.data.date.getTime() - b.data.date.getTime());
}

// Get unique years for nav pills
const years = [...new Set(sortedSeasons.map(([slug]) => slug.split('-')[1]))].sort((a, b) => parseInt(b) - parseInt(a));

const seasonData = sortedSeasons.map(([slug, evts]) => {
  const [part, year] = slug.split('-');
  return {
    slug,
    year,
    label: `${year} ${part.toUpperCase()}`,
    events: evts,
  };
});
---
<Layout title="Conversations Series">
  {isClassic ? (
    <div>
      <div class="c-page-header">
        <h1>Conversations at the Schomburg</h1>
      </div>
      <ul class="c-year-nav">
        {years.map(year => (
          <li><a href={`#${year}`}>{year}</a></li>
        ))}
      </ul>
      {seasonData.map(season => (
        <section id={season.year}>
          <h3 class="c-season-header">{season.label}</h3>
          <ul class="c-events-list">
            {season.events.map(event => {
              const month = event.data.date.toLocaleDateString('en-US', { month: 'short' });
              const day = String(event.data.date.getDate()).padStart(2, '0');
              const eventSpeakers = event.data.speakers
                .map((slug: string) => allSpeakers.find(s => s.id === slug))
                .filter(Boolean);
              return (
                <li class="c-event-card">
                  <a href={`/events/${season.slug}/${event.id}`}>
                    <div class="c-event-header">
                      <div class="c-event-date">
                        <h2>
                          <span class="c-event-date__month">{month}</span>
                          <span class="c-event-date__day">{day}</span>
                        </h2>
                      </div>
                      <div class="c-event-name">
                        <h2>{event.data.title}</h2>
                      </div>
                    </div>
                    {event.data.books.length > 0 && (
                      <div class="c-book-grid">
                        {event.data.books.map((book: any) => (
                          <div class="c-book-grid-item">
                            <Image src={book} alt="" width={200} />
                          </div>
                        ))}
                      </div>
                    )}
                    <ul class="c-event-speakers">
                      {eventSpeakers.map((speaker: any) => (
                        <li>
                          <h3 class="c-event-speakers-name">{speaker.data.name}</h3>
                          {speaker.data.affiliation && (
                            <div class="c-event-speakers-affiliation">{speaker.data.affiliation}</div>
                          )}
                        </li>
                      ))}
                    </ul>
                  </a>
                </li>
              );
            })}
          </ul>
        </section>
      ))}
    </div>
  ) : (
    <div>
      <div class="r-page-header">
        <h1>Conversations Series</h1>
        <p>Monthly roundtable discussions at the Schomburg Center</p>
      </div>
      {(async () => {
        const { default: SeasonTimeline } = await import('../../components/redesign/SeasonTimeline.astro');
        const simpleSeasonData = seasonData.map(s => ({ slug: s.slug, label: s.label, eventCount: s.events.length }));
        return <SeasonTimeline seasons={simpleSeasonData} />;
      })()}
    </div>
  )}
</Layout>
