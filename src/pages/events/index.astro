---
import { getCollection } from 'astro:content';
import { Layout, isClassic } from '../../lib/theme';
import BookCover from '../../components/shared/BookCover.astro';
import EventRow from '../../components/redesign/EventRow.astro';

const events = await getCollection('events');
const allSpeakers = await getCollection('speakers');

const seasons = new Map<string, typeof events>();
for (const event of events) {
  const key = `${event.data.seasonPart}-${event.data.seasonYear}`;
  if (!seasons.has(key)) seasons.set(key, []);
  seasons.get(key)!.push(event);
}

const partOrder: Record<string, number> = { fall: 2, spring: 1, special: 0 };
const sortedSeasons = [...seasons.entries()].sort((a, b) => {
  const aYear = parseInt(a[0].split('-')[1]);
  const bYear = parseInt(b[0].split('-')[1]);
  if (aYear !== bYear) return bYear - aYear;
  const aPart = a[0].split('-')[0];
  const bPart = b[0].split('-')[0];
  return (partOrder[bPart] ?? 0) - (partOrder[aPart] ?? 0);
});

// Sort events within each season by date
for (const [, evts] of sortedSeasons) {
  evts.sort((a, b) => a.data.date.getTime() - b.data.date.getTime());
}

// Get unique years for nav pills
const years = [...new Set(sortedSeasons.map(([slug]) => slug.split('-')[1]))].sort((a, b) => parseInt(b) - parseInt(a));

const seasonData = sortedSeasons.map(([slug, evts], i) => {
  const [part, year] = slug.split('-');
  return {
    slug,
    year,
    // Classic keeps its "2026 FALL" label; redesign uses the season page's title form
    label: `${year} ${part.toUpperCase()}`,
    title: `${part.charAt(0).toUpperCase() + part.slice(1)} ${year}`,
    // The first (latest) season of each year carries the year's jump-link anchor
    firstOfYear: i === 0 || sortedSeasons[i - 1][0].split('-')[1] !== year,
    events: evts,
  };
});

const speakersFor = (event: (typeof events)[number]) =>
  event.data.speakers
    .map((slug: string) => allSpeakers.find(s => s.id === slug))
    .filter((s): s is (typeof allSpeakers)[number] => Boolean(s));

// Next conversation, kept as "next" through its whole day (dates are UTC midnight)
const DAY_MS = 24 * 60 * 60 * 1000;
const nextEvent = [...events]
  .filter(e => e.data.date.getTime() + DAY_MS > Date.now())
  .sort((a, b) => a.data.date.getTime() - b.data.date.getTime())[0];
const nextDate = nextEvent?.data.date.toLocaleDateString('en-US', {
  weekday: 'long', month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC',
});
const nextSpeakers = nextEvent ? speakersFor(nextEvent) : [];
const nextUrl = nextEvent ? `/events/${nextEvent.data.seasonPart}-${nextEvent.data.seasonYear}/${nextEvent.id}` : '';
---
<Layout title="Conversations Series" description="Browse the complete archive of Conversations in Black Freedom Studies events at the Schomburg Center, featuring roundtable discussions with leading scholars in Black history.">
  {isClassic ? (
    <div>
      <div class="c-page-header">
        <h1>Conversations at the Schomburg</h1>
      </div>
      <ul class="c-year-nav">
        {years.map(year => (
          <li><a href={`#${year}`}>{year}</a></li>
        ))}
      </ul>
      {seasonData.map(season => (
        <section id={season.year}>
          <h3 class="c-season-header">{season.label}</h3>
          <ul class="c-events-list">
            {season.events.map(event => {
              const month = event.data.date.toLocaleDateString('en-US', { month: 'short', timeZone: 'UTC' });
              const day = String(event.data.date.getUTCDate()).padStart(2, '0');
              const eventSpeakers = event.data.speakers
                .map((slug: string) => allSpeakers.find(s => s.id === slug))
                .filter(Boolean);
              return (
                <li class="c-event-card">
                  <a href={`/events/${season.slug}/${event.id}`}>
                    <div class="c-event-header">
                      <div class="c-event-date">
                        <h2>
                          <span class="c-event-date__month">{month}</span>
                          <span class="c-event-date__day">{day}</span>
                        </h2>
                      </div>
                      <div class="c-event-name">
                        <h2>{event.data.title}</h2>
                      </div>
                    </div>
                    {event.data.books.length > 0 && (
                      <div class="c-book-grid">
                        {event.data.books.map((book: any) => (
                          <div class="c-book-grid-item">
                            <BookCover src={book} width={200} alt="" />
                          </div>
                        ))}
                      </div>
                    )}
                    <ul class="c-event-speakers">
                      {eventSpeakers.map((speaker: any) => (
                        <li>
                          <h3 class="c-event-speakers-name">{speaker.data.name}</h3>
                          {speaker.data.affiliation && (
                            <div class="c-event-speakers-affiliation">{speaker.data.affiliation}</div>
                          )}
                        </li>
                      ))}
                    </ul>
                  </a>
                </li>
              );
            })}
          </ul>
        </section>
      ))}
    </div>
  ) : (
    <div>
      <div class="r-page-header">
        <h1>Conversations</h1>
        <p>Monthly roundtable discussions at the Schomburg Center, {years[years.length - 1]}–{years[0]}</p>
      </div>

      {nextEvent && (
        <section class="r-next-event" aria-labelledby="next-event-label">
          <p class="r-next-event__label" id="next-event-label">Next conversation</p>
          <h2 class="r-next-event__title"><a href={nextUrl}>{nextEvent.data.title}</a></h2>
          <p class="r-next-event__meta">
            <time datetime={nextEvent.data.date.toISOString().slice(0, 10)}>{nextDate}</time>
            {nextSpeakers.length > 0 && <> · {nextSpeakers.map(s => s.data.name).join(', ')}</>}
          </p>
          <div class="r-next-event__actions">
            <a class="r-btn" href={nextUrl}>Event details</a>
            {nextEvent.data.eventbrite && <a class="r-btn r-btn--outline" href={nextEvent.data.eventbrite} rel="noopener">Register ↗</a>}
          </div>
          {nextEvent.data.books.length > 0 && (
            <div class="r-next-event__books" aria-hidden="true">
              {nextEvent.data.books.slice(0, 4).map((book: any) => <BookCover src={book} width={90} height={135} alt="" />)}
            </div>
          )}
        </section>
      )}

      <div class="r-archive-bar">
        <label class="r-archive-bar__search">
          <span class="r-visually-hidden">Search conversations</span>
          <input type="search" id="event-search" placeholder="Search by title or speaker…" autocomplete="off" />
        </label>
        <nav class="r-archive-bar__years" aria-label="Jump to year">
          {years.map(year => <a href={`#y${year}`}>{year}</a>)}
        </nav>
      </div>
      <p class="r-archive-empty" id="event-search-empty" hidden>No conversations match.</p>

      {seasonData.map(season => (
        <section class="r-season-group" id={season.firstOfYear ? `y${season.year}` : undefined} aria-labelledby={`s-${season.slug}`}>
          <h2 class="r-season-group__label" id={`s-${season.slug}`}>
            <a href={`/events/${season.slug}/`}>{season.title}</a>
            <span class="r-season-group__count">{season.events.length} conversation{season.events.length !== 1 ? 's' : ''}</span>
          </h2>
          <div class="r-season-group__events">
            {season.events.map(event => <EventRow event={event} speakers={speakersFor(event)} />)}
          </div>
        </section>
      ))}

      <script>
        // Filter rows by title/speaker; hide seasons with no matches
        const input = document.getElementById('event-search') as HTMLInputElement | null;
        const empty = document.getElementById('event-search-empty');
        input?.addEventListener('input', () => {
          const q = input.value.trim().toLowerCase();
          let shown = 0;
          document.querySelectorAll<HTMLElement>('.r-season-group').forEach(group => {
            let groupShown = 0;
            group.querySelectorAll<HTMLElement>('.r-event-row').forEach(row => {
              const match = !q || (row.dataset.search ?? '').includes(q);
              row.hidden = !match;
              if (match) groupShown++;
            });
            group.hidden = groupShown === 0;
            shown += groupShown;
          });
          if (empty) empty.hidden = shown > 0;
        });
      </script>
    </div>
  )}
</Layout>
