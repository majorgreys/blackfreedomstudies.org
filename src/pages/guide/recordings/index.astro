---
import { Layout } from '../../../lib/theme';
import { formatDate, recordingInfo, transcriptUrl, youtubeUrl } from '../../../lib/guide';

const info = await recordingInfo();
const rows = Object.entries(info).sort(([, a], [, b]) => b.date.localeCompare(a.date));
---
<Layout title="Recordings: Guide to the Recordings" description="Every Conversations in Black Freedom Studies recording in the guide.">
  <div class="r-page-header">
    <p><a href="/guide/">Guide to the Recordings</a></p>
    <h1>The recordings</h1>
  </div>
  <ul class="r-guide-recordings">
    {rows.map(([v, r]) => (
      <li>
        <span class="r-guide-recordings__date">{formatDate(r.date)}</span>
        <a href={r.hasTranscript ? transcriptUrl(v) : youtubeUrl(v)}>{r.title}</a>
      </li>
    ))}
  </ul>
</Layout>
