---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { Layout, isClassic } from '../../lib/theme';

const speakers = (await getCollection('speakers'))
  .sort((a, b) => a.data.name.localeCompare(b.data.name));

// Redesign lists speakers by surname, grouped by its first letter
const SUFFIXES = new Set(['jr', 'jr.', 'sr', 'sr.', 'ii', 'iii', 'iv']);
const surname = (name: string) => {
  const words = name.trim().split(/\s+/).filter(w => !SUFFIXES.has(w.toLowerCase().replace(/,$/, '')));
  return words[words.length - 1] ?? name;
};
const initials = (name: string) => {
  const words = name.trim().split(/\s+/).filter(w => /^[A-Za-z]/.test(w) && !SUFFIXES.has(w.toLowerCase()));
  return ((words[0]?.[0] ?? '') + (words.length > 1 ? words[words.length - 1][0] : '')).toUpperCase();
};
const bySurname = [...speakers].sort((a, b) =>
  surname(a.data.name).localeCompare(surname(b.data.name), 'en', { sensitivity: 'base' })
  || a.data.name.localeCompare(b.data.name));
const groups = new Map<string, typeof speakers>();
for (const sp of bySurname) {
  const letter = surname(sp.data.name).normalize('NFD')[0].toUpperCase();
  if (!groups.has(letter)) groups.set(letter, []);
  groups.get(letter)!.push(sp);
}
const letters = [...groups.keys()];
---
<Layout title="Speakers" description="Authors, scholars, and experts who have participated in Conversations in Black Freedom Studies at the Schomburg Center.">
  {isClassic ? (
    <div>
      <h1>Speakers</h1>
      <ul class="c-speaker-grid">
        {speakers.map(speaker => (
          <li class="c-speaker-grid-item">
            {speaker.data.image && (
              <Image src={speaker.data.image} alt="" width={320} height={320} />
            )}
            <h3><a href={`/speakers/${speaker.id}`}>{speaker.data.name}</a></h3>
            {speaker.data.affiliation && <span class="affiliation">{speaker.data.affiliation}</span>}
          </li>
        ))}
      </ul>
    </div>
  ) : (
    <div>
      <div class="r-page-header">
        <h1>Speakers</h1>
        <p>{speakers.length} authors, scholars, and experts in Black history</p>
      </div>

      <div class="r-archive-bar">
        <label class="r-archive-bar__search">
          <span class="r-visually-hidden">Search speakers</span>
          <input type="search" id="speaker-search" placeholder="Search by name or institution…" autocomplete="off" />
        </label>
        <nav class="r-archive-bar__years r-archive-bar__letters" aria-label="Jump to letter">
          {letters.map(l => <a href={`#letter-${l}`}>{l}</a>)}
        </nav>
      </div>
      <p class="r-archive-empty" id="speaker-search-empty" hidden>No speakers match.</p>
      <p class="r-visually-hidden" role="status" id="speaker-search-status"></p>

      {letters.map(letter => (
        <section class="r-speaker-letter" id={`letter-${letter}`} aria-labelledby={`h-${letter}`}>
          <h2 class="r-speaker-letter__heading" id={`h-${letter}`}>{letter}</h2>
          <ul class="r-speaker-grid">
            {groups.get(letter)!.map(speaker => (
              <li class="r-speaker-grid-item" data-search={`${speaker.data.name} ${speaker.data.affiliation ?? ''}`.toLowerCase()}>
                <a href={`/speakers/${speaker.id}`}>
                  {speaker.data.image ? (
                    <Image src={speaker.data.image} alt="" width={240} height={240} />
                  ) : (
                    <span class="r-speaker-initials" aria-hidden="true">{initials(speaker.data.name)}</span>
                  )}
                  <span class="r-speaker-grid-item__name">{speaker.data.name}</span>
                  {speaker.data.affiliation && <span class="affiliation">{speaker.data.affiliation}</span>}
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))}

      <script>
        const input = document.getElementById('speaker-search') as HTMLInputElement | null;
        const empty = document.getElementById('speaker-search-empty');
        input?.addEventListener('input', () => {
          const q = input.value.trim().toLowerCase();
          let shown = 0;
          document.querySelectorAll<HTMLElement>('.r-speaker-letter').forEach(section => {
            let n = 0;
            section.querySelectorAll<HTMLElement>('.r-speaker-grid-item').forEach(item => {
              const match = !q || (item.dataset.search ?? '').includes(q);
              item.hidden = !match;
              if (match) n++;
            });
            section.hidden = n === 0;
            shown += n;
          });
          if (empty) empty.hidden = shown > 0;
          const status = document.getElementById('speaker-search-status');
          if (status) status.textContent = q ? `${shown} ${shown === 1 ? 'speaker' : 'speakers'} match` : '';
        });
      </script>
    </div>
  )}
</Layout>
