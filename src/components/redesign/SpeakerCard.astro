---
import { Image } from 'astro:assets';

interface Props {
  name: string;
  slug: string;
  affiliation?: string;
  image?: ImageMetadata | string;
  email?: string;
  twitter?: string;
  social?: string;
  homepage?: string;
  compact?: boolean;
}

const { name, slug, affiliation, image, email, twitter, social, homepage, compact = false } = Astro.props;
const initials = name.split(/\s+/).filter(w => /^[A-Za-z]/.test(w)).map(w => w[0]).slice(0, 1)
  .concat(name.split(/\s+/).filter(w => /^[A-Za-z]/.test(w)).slice(-1).map(w => w[0])).join('').toUpperCase();
---
<li class="r-speaker-item">
  {image ? (
    <Image src={image} alt="" class="r-speaker-headshot" width={192} height={192} />
  ) : (
    <div class="r-speaker-placeholder" aria-hidden="true">{initials}</div>
  )}
  <div class="r-speaker-info">
    <h3><a href={`/speakers/${slug}`}>{name}</a></h3>
    {affiliation && <span class="affiliation">{affiliation}</span>}
    <div class="r-speaker-social">
      {homepage && <a href={homepage}>Website</a>}
      {email && <a href={`mailto:${email}`}>Email</a>}
      {twitter && <a href={`https://twitter.com/${twitter}`}>Twitter</a>}
      {social && <a href={social}>Social</a>}
    </div>
    {!compact && <slot />}
  </div>
</li>
