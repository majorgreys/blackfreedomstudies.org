---
// Plays YouTube and Vimeo links marked data-play-video in a dialog, starting at the link's
// timestamp, or the data-video-url it names. Links still work normally without JavaScript or with a modifier key held.
---
<dialog class="r-video" id="video-dialog" aria-labelledby="video-title">
  <div class="r-video__bar">
    <p class="r-video__title" id="video-title"></p>
    <a class="r-video__source" id="video-source" target="_blank" rel="noopener"></a>
    <button class="r-video__close" id="video-close" type="button" aria-label="Close video">×</button>
  </div>
  <div class="r-video__frame" id="video-frame"></div>
</dialog>

<script>
  const dialog = document.getElementById('video-dialog') as HTMLDialogElement;
  const title = document.getElementById('video-title')!;
  const source = document.getElementById('video-source') as HTMLAnchorElement;
  const frame = document.getElementById('video-frame')!;

  function embed(href: string) {
    const url = new URL(href);
    const id = url.searchParams.get('v');
    if (url.hostname.includes('youtube.com') && id) {
      const start = parseInt(url.searchParams.get('t') ?? '0', 10);
      return { src: `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0${start ? `&start=${start}` : ''}`, name: 'YouTube' };
    }
    const vimeo = url.hostname.includes('vimeo.com') && url.pathname.match(/(\d+)\/?$/);
    return vimeo ? { src: `https://player.vimeo.com/video/${vimeo[1]}?autoplay=1`, name: 'Vimeo' } : null;
  }

  document.addEventListener('click', e => {
    const event = e as MouseEvent;
    const link = (event.target as Element).closest<HTMLAnchorElement>('a[data-play-video]');
    if (!link || event.metaKey || event.ctrlKey || event.shiftKey || event.button !== 0) return;
    const href = link.dataset.videoUrl ?? link.href;
    const video = embed(href);
    if (!video) return;
    event.preventDefault();
    title.textContent = link.dataset.playVideo ?? '';
    source.href = href;
    source.textContent = `Open on ${video.name} ↗`;
    const iframe = document.createElement('iframe');
    iframe.src = video.src;
    iframe.title = `Recording: ${title.textContent}`;
    iframe.allow = 'autoplay; encrypted-media; fullscreen; picture-in-picture';
    iframe.allowFullscreen = true;
    iframe.referrerPolicy = 'strict-origin-when-cross-origin'; // YouTube refuses to play without a referrer
    frame.replaceChildren(iframe);
    dialog.showModal();
  });

  document.getElementById('video-close')!.addEventListener('click', () => dialog.close());
  dialog.addEventListener('click', e => { if (e.target === dialog) dialog.close(); });
  // Removing the player stops playback
  dialog.addEventListener('close', () => frame.replaceChildren());
</script>
