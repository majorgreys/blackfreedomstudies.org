---
interface Season {
  slug: string;
  label: string;
  eventCount: number;
}

interface Props {
  seasons: Season[];
}

const { seasons } = Astro.props;
---
<ul class="r-seasons-list">
  {seasons.map(season => (
    <li>
      <a href={`/events/${season.slug}`} class="r-season-card">
        <div class="r-season-card__accent"></div>
        <div class="r-season-card__info">
          <h3>{season.label}</h3>
          <span class="r-season-card__meta">{season.eventCount} conversation{season.eventCount !== 1 ? 's' : ''}</span>
        </div>
      </a>
    </li>
  ))}
</ul>
