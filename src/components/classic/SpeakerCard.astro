---
import { Image } from 'astro:assets';

interface Props {
  name: string;
  slug: string;
  affiliation?: string;
  image?: ImageMetadata;
  email?: string;
  twitter?: string;
  social?: string;
  homepage?: string;
  compact?: boolean;
}

const { name, slug, affiliation, image, email, twitter, social, homepage, compact = false } = Astro.props;
---
<li class="c-speaker-item">
  {image ? (
    <Image src={image} alt={name} class="c-speaker-headshot" width={300} />
  ) : (
    <div class="c-speaker-placeholder">👤</div>
  )}
  <div class="c-speaker-info">
    <h3>{name}</h3>
    {affiliation && <span class="affiliation">{affiliation}</span>}
    <div class="c-speaker-social">
      {homepage && <a href={homepage}>Website</a>}
      {email && <a href={`mailto:${email}`}>Email</a>}
      {twitter && <a href={`https://twitter.com/${twitter}`}>Twitter</a>}
      {social && <a href={social}>Social</a>}
    </div>
    {!compact && <slot />}
  </div>
</li>
