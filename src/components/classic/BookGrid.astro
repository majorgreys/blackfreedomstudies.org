---
import { Image } from 'astro:assets';

interface Props {
  books: ImageMetadata[];
}

const { books } = Astro.props;
---
{books.length > 0 && (
  <div class="c-book-grid">
    {books.map((book) => (
      <div class="c-book-grid-item">
        <div class="c-book-grid-img">
          <Image src={book} alt="Book cover" width={200} />
        </div>
      </div>
    ))}
  </div>
)}
