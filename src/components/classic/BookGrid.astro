---
import BookCover from '../shared/BookCover.astro';

interface Props {
  books: Array<ImageMetadata | string>;
}

const { books } = Astro.props;
---
{books.length > 0 && (
  <div class="c-book-grid">
    {books.map((book) => (
      <div class="c-book-grid-item">
        <div class="c-book-grid-img">
          <BookCover src={book} width={200} />
        </div>
      </div>
    ))}
  </div>
)}
