---
import SEOHead from '../components/shared/SEOHead.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  ogType?: string;
  jsonLd?: Record<string, unknown>;
}

const { title, description, image, ogType, jsonLd } = Astro.props;
const theme = (import.meta as any).env?.THEME || 'redesign';
const isClassic = theme === 'classic';
const cssPath = isClassic ? '/css/classic.css' : '/css/redesign.css';

// Current section, for aria-current and the active nav style
const path = Astro.url.pathname;
const section = (prefix: string) => path === prefix || path.startsWith(prefix.endsWith('/') ? prefix : prefix + '/');
const current = (prefix: string) => (section(prefix) ? 'page' : undefined);
const inArchive = ['/interviews/', '/books', '/resources/'].some(section);
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  <link rel="stylesheet" href={cssPath} />
  <SEOHead title={title} description={description} image={image} url={Astro.url.href} type={ogType} jsonLd={jsonLd} />
</head>
<body>
  <a class={isClassic ? 'c-skip-link' : 'r-skip-link'} href="#main">Skip to content</a>
  {isClassic ? (
    <nav class="c-navbar">
      <div class="c-navbar__inner">
        <a class="c-navbar__brand" href="/">Black<br/>Freedom<br/>Studies</a>
        <button class="c-navbar__toggle" aria-label="Toggle navigation" id="nav-toggle">☰</button>
        <ul class="c-navbar__links" id="nav-links">
          <li><a href="/events/">Conversations Series</a></li>
          <li><a href="/neh-seminar-2015">NEH Summer Seminar</a></li>
          <li><a href="/news/">News</a></li>
          <li><a href="/about">About</a></li>
        </ul>
      </div>
    </nav>
  ) : (
    <nav class="r-navbar">
      <a class="r-navbar__brand" href="/"><span class="r-brand-line1">Black</span><br/><span class="r-brand-line2">Freedom</span><br/><span class="r-brand-line3">Studies</span></a>
      <div class="r-navbar__bar">
        <button class="r-navbar__toggle" aria-label="Menu" aria-expanded="false" aria-controls="nav-links" id="nav-toggle">☰</button>
        <ul class="r-navbar__links" id="nav-links">
          <li><a href="/events/" aria-current={current('/events/')}>Conversations</a></li>
          <li><a href="/speakers/" aria-current={current('/speakers/')}>Speakers</a></li>
          <li class="r-navbar__dropdown">
            <button class:list={['r-navbar__dropdown-trigger', { 'is-current': inArchive }]} type="button" aria-expanded="false" aria-controls="nav-archive">Archive</button>
            <ul class="r-navbar__dropdown-menu" id="nav-archive">
              <li><a href="/resources/" aria-current={current('/resources/')}>Recordings</a></li>
              <li><a href="/interviews/" aria-current={current('/interviews/')}>Interviews</a></li>
              <li><a href="/books" aria-current={current('/books')}>Books</a></li>
            </ul>
          </li>
          <li><a href="/news/" aria-current={current('/news/')}>News</a></li>
          <li><a href="/about" aria-current={current('/about')}>About</a></li>
        </ul>
      </div>
    </nav>
  )}

  <main class="container" id="main" tabindex="-1">
    <slot />
  </main>

  {isClassic ? (
    <footer class="c-footer">
      <div class="container">
        <p>Follow us on <a href="https://twitter.com/SchomburgCBFS">@SchomburgCBFS</a></p>
        <p>Send comments and questions to <a href="mailto:blackfreedomstudies@gmail.com">blackfreedomstudies@gmail.com</a></p>
        <p>CBFS is supported by the <a href="https://www.nypl.org/locations/schomburg">Schomburg Center for Research in Black Culture</a> and the <a href="https://gc.cuny.edu">City University of New York (CUNY) Graduate Center</a>.</p>
      </div>
    </footer>
  ) : (
    <footer class="r-footer">
      <div class="r-footer__bar">
        <div class="r-footer__content">
          <div class="r-footer__info">
            <a href="mailto:blackfreedomstudies@gmail.com">Email us</a>
            <span class="r-footer__sep">·</span>
            <a href="https://twitter.com/SchomburgCBFS">Follow us on X</a>
          </div>
          <div class="r-footer__sponsors">
            Supported by the <a href="https://www.nypl.org/locations/schomburg">Schomburg Center for Research in Black Culture</a> and the <a href="https://gc.cuny.edu">CUNY Graduate Center</a>
          </div>
        </div>
        <div class="r-footer__brand">
          <span class="r-brand-line1">Black</span><br/>
          <span class="r-brand-line2">Freedom</span><br/>
          <span class="r-brand-line3">Studies</span>
        </div>
      </div>
    </footer>
  )}

  <script>
    const toggle = document.getElementById('nav-toggle');
    toggle?.addEventListener('click', () => {
      const open = document.getElementById('nav-links')?.classList.toggle('is-open') ?? false;
      toggle.setAttribute('aria-expanded', String(open));
    });

    // Archive dropdown: opens on hover (CSS) and by click or keyboard here
    const dropdown = document.querySelector('.r-navbar__dropdown');
    const trigger = dropdown?.querySelector<HTMLButtonElement>('.r-navbar__dropdown-trigger');
    const setOpen = (open: boolean) => {
      dropdown?.classList.toggle('is-open', open);
      trigger?.setAttribute('aria-expanded', String(open));
    };
    trigger?.addEventListener('click', () => setOpen(!dropdown?.classList.contains('is-open')));
    dropdown?.addEventListener('keydown', (e) => {
      if ((e as KeyboardEvent).key === 'Escape') { setOpen(false); trigger?.focus(); }
    });
    dropdown?.addEventListener('focusout', (e) => {
      if (!dropdown.contains((e as FocusEvent).relatedTarget as Node)) setOpen(false);
    });
    document.addEventListener('click', (e) => {
      if (dropdown && !dropdown.contains(e.target as Node)) setOpen(false);
    });
  </script>
</body>
</html>
